# Supabase Configuration for Authentication
# Using the Application Database (same as APP_DB in backend)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_FRONTEND_URL=http://localhost:5174

# PayPal Configuration
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Alchemy Configuration for Smart Wallets
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here
VITE_ALCHEMY_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
