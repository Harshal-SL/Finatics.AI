# Banking Database Configuration (Supabase)
BANKING_DB_URL=your_banking_db_supabase_url_here
BANKING_DB_ANON_KEY=your_banking_db_anon_key_here

# Application Database Configuration (Supabase)
APP_DB_URL=your_app_db_supabase_url_here
APP_DB_ANON_KEY=your_app_db_anon_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Example:
# BANKING_DB_URL=https://banking-project-id.supabase.co
# BANKING_DB_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# APP_DB_URL=https://app-project-id.supabase.co
# APP_DB_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...